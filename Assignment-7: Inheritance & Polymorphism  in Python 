    {
      "cell_type": "markdown",
      "source": [
        "5. Access Parent Method using super()"
      ],
      "metadata": {
        "id": "SZahcVi1H00M"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class A:\n",
        "    def common_method(self):\n",
        "        print(\"Common Method from A\")\n",
        "\n",
        "class B(A):\n",
        "    def common_method(self):\n",
        "        super().common_method()\n",
        "        print(\"Common Method from B\")\n",
        "\n",
        "class C(B):\n",
        "    def common_method(self):\n",
        "        super().common_method()\n",
        "        print(\"Common Method from C\")\n",
        "\n",
        "obj = C()\n",
        "obj.common_method()"
