      "source": [
        "6. Instance Variables Behavior"
      ],
      "metadata": {
        "id": "y2ipP7iVH-nv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class A:\n",
        "    def __init__(self):\n",
        "        self.name = \"Class A\"\n",
        "\n",
        "class B(A):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.name = \"Class B\"\n",
        "\n",
        "class C(B):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.name = \"Class C\"\n",
        "\n",
        "a = A()\n",
        "b = B()\n",
        "c = C()\n",
        "\n",
        "print(\"Object A:\", a.name)\n",
        "print(\"Object B:\", b.name)\n",
        "print(\"Object C:\", c.name)\n",
        "\n",
        "ref = B()\n",
        "print(\"Superclass Reference to B:\", ref.name)\n",
        "\n",
        "ref = C()\n",
        "print(\"Superclass Reference to C:\", ref.name)"
      ],
