        "8. Real-World Example (Vehicle → Car → ElectricCar)"
      ],
      "metadata": {
        "id": "Z3NLixFKIXlR"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class Vehicle:\n",
        "    def start_engine(self):\n",
        "        print(\"Vehicle engine started\")\n",
        "\n",
        "    def stop_engine(self):\n",
        "        print(\"Vehicle engine stopped\")\n",
        "\n",
        "class Car(Vehicle):\n",
        "    def start_engine(self):\n",
        "        super().start_engine()\n",
        "        print(\"Car engine started with key\")\n",
        "\n",
        "    def drive(self):\n",
        "        print(\"Car is driving\")\n",
        "\n",
        "class ElectricCar(Car):\n",
        "    def start_engine(self):\n",
        "        super().start_engine()\n",
        "        print(\"Electric Car starts silently\")\n",
        "\n",
        "    def charge(self):\n",
        "        print(\"Electric Car is charging\")\n",
        "\n",
        "ev = ElectricCar()\n",
        "\n",
        "ev.start_engine()\n",
        "ev.drive()\n",
        "ev.charge()\n",
        "ev.stop_engine()"
      ],
